# True or False to enable/disable debug mode
DEBUG_MODE=""

# Ko-fi verification token
KOFI_VERIFICATION_TOKEN=""

# your MongoDB database url
MONGODB_URL=""

# fernet encryption key, generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENC_KEY=""

# jwt key, generate with:
# python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_KEY=""

# powerdns api key
PDNS_API_KEY=""

# put a url to your powerdns api here
# format: http://<ip>:<port> - no trailing slash or path
PDNS_DOMAIN=""

# put an ipinfo api key here
IPINFO_KEY=""

# put a sentry dsn url here for backend error logging
SENTRY_DSN=""

# paste a discord webhook url here to send alerts to
DC_WEBHOOK=""

# put a cloudflare turnstile secret key here
TURNSTILE_KEY=""

# put a resend api key here
RESEND_KEY=""

# redis url here
REDIS_URL=""

# == caddy config ==
# only fill in if you're using the caddy reverse proxy for the backend

# email for caddy ssl cert
CADDY_EMAIL=""

# domain for caddy to serve the backend on
CADDY_DOMAIN=""


# IMPORTANT: only set the following vars if you're using PowerPCFan/eepy.page-admin-panel -- see ./Caddyfile for more info)

# domain for caddy to serve the admin panel on
# CADDY_PANEL_DOMAIN=""

# path to the eepy.page-admin-panel directory, no trailing slash, e.g. /home/username/eepy.page-admin-panel
# CADDY_PANEL_PATH=""